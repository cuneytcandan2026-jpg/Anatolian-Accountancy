# Store and check out every text file with LF endings, whatever the
# committer's core.autocrlf setting, so diffs only ever show real changes.
* text=auto eol=lf

# Binary assets: never normalise or diff as text
*.jpg   binary
*.jpeg  binary
*.png   binary
*.gif   binary
*.webp  binary
*.avif  binary
*.ico   binary
*.mp4   binary
*.webm  binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary
*.pdf   binary
