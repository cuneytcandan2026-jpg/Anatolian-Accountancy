---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import ScrollToTop from '../components/ScrollToTop.astro';
import CookieBanner from '../components/CookieBanner.astro';
import { getImage } from 'astro:assets';
import { site, withBase, langAlternates, langAlternatesReverse, primaryNav, primaryNavTr } from '../lib/site';
import { businessNode, personNode, websiteNode, breadcrumbNode, ids, inLanguage, type Crumb } from '../lib/schema';
import founderPhoto from '../assets/founder-photo.jpg';
import frauncesLatin from '@fontsource-variable/fraunces/files/fraunces-latin-standard-normal.woff2?url';
import frauncesLatinExt from '@fontsource-variable/fraunces/files/fraunces-latin-ext-standard-normal.woff2?url';
import interLatin from '@fontsource-variable/inter/files/inter-latin-wght-normal.woff2?url';
import interLatinExt from '@fontsource-variable/inter/files/inter-latin-ext-wght-normal.woff2?url';

interface Props {
  title: string;
  description: string;
  path?: string;
  noIndex?: boolean;
  lang?: 'en' | 'tr';
  altHref?: string;
  // schema.org type of this page's WebPage node.
  pageType?: 'WebPage' | 'AboutPage' | 'ContactPage' | 'CollectionPage';
  // Trail after Home. Defaults to the nav label (or title) of this page, so
  // only nested pages such as blog posts need to pass it.
  breadcrumbs?: Crumb[];
  // Extra JSON-LD nodes for this page (Service, BlogPosting...), merged into
  // the same @graph so they can reference the shared business by @id.
  schema?: Record<string, unknown>[];
  // @id of the node this page is mainly about, if not the business.
  mainEntityId?: string;
}

const {
  title,
  description,
  path = '/',
  noIndex = false,
  lang = 'en',
  altHref,
  pageType = 'WebPage',
  breadcrumbs,
  schema = [],
  mainEntityId,
} = Astro.props;

const canonicalURL = new URL(withBase(path), site.url).toString();
// Share cards are rendered from scripts/og-image/ (EN + TR variants).
const ogImageURL = new URL(withBase(lang === 'tr' ? '/og-image-tr.jpg' : '/og-image.jpg'), site.url).toString();
const ogImageAlt =
  lang === 'tr'
    ? `${site.name}: İşinizi kolaylaştıran muhasebe. Türkçe ve İngilizce.`
    : `${site.name}: Accountancy that makes business simpler. In English and Turkish.`;

// One JSON-LD @graph per indexable page (see src/lib/schema.ts). noIndex
// pages (404, legal pages) get none.
const homePath = lang === 'tr' ? '/tr/' : '/';
const isHome = path === homePath;
const navItems = lang === 'tr' ? primaryNavTr : primaryNav;
const pageLabel =
  navItems.find((item) => item.href === path)?.label ?? title.replace(` | ${site.name}`, '');
const crumbs: Crumb[] | undefined = isHome
  ? undefined
  : [{ name: lang === 'tr' ? 'Ana Sayfa' : 'Home', path: homePath }, ...(breadcrumbs ?? [{ name: pageLabel, path }])];
const founderImage = (await getImage({ src: founderPhoto, width: 367, format: 'jpg' })).src;
const graph = noIndex
  ? undefined
  : {
      '@context': 'https://schema.org',
      '@graph': [
        {
          '@type': pageType,
          '@id': `${canonicalURL}#webpage`,
          url: canonicalURL,
          name: title,
          description,
          inLanguage: inLanguage(lang),
          isPartOf: { '@id': ids.website },
          about: { '@id': ids.business },
          ...(mainEntityId ? { mainEntity: { '@id': mainEntityId } } : {}),
          ...(crumbs ? { breadcrumb: { '@id': `${canonicalURL}#breadcrumb` } } : {}),
        },
        websiteNode(),
        businessNode(),
        personNode(new URL(founderImage, site.url).toString()),
        ...(crumbs ? [breadcrumbNode(canonicalURL, crumbs)] : []),
        ...schema,
      ],
    };

// hreflang: emitted for the static EN<->TR page pairs (langAlternates in
// site.ts), or for the explicit altHref override on pages whose pairing
// isn't a fixed 1:1 path map (e.g. individual blog posts) — pages with no
// translated twin (404) get neither.
const altPath = altHref ?? langAlternates[path] ?? langAlternatesReverse[path];
const enPath = lang === 'tr' ? altPath : path;
const trPath = lang === 'tr' ? path : altPath;

// Turkish headings use characters (ş, ğ, İ, ı) outside the "latin" subset,
// so preload the "latin-ext" font files on TR pages instead.
const frauncesPreload = lang === 'tr' ? frauncesLatinExt : frauncesLatin;
const interPreload = lang === 'tr' ? interLatinExt : interLatin;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href={withBase('/favicon.ico')} sizes="32x32" />
    <link rel="icon" type="image/svg+xml" href={withBase('/favicon.svg')} />
    <link rel="icon" type="image/png" sizes="32x32" href={withBase('/favicon-32x32.png')} />
    <link rel="apple-touch-icon" href={withBase('/apple-touch-icon.png')} />
    <link rel="manifest" href={withBase('/site.webmanifest')} />
    <meta name="theme-color" content="#fdfbf7" />
    <link rel="preload" href={frauncesPreload} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={interPreload} as="font" type="font/woff2" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    {altPath && (
      <>
        <link rel="alternate" hreflang="en" href={new URL(withBase(enPath), site.url).toString()} />
        <link rel="alternate" hreflang="tr" href={new URL(withBase(trPath), site.url).toString()} />
        <link rel="alternate" hreflang="x-default" href={new URL(withBase(enPath), site.url).toString()} />
      </>
    )}
    {noIndex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={lang === 'tr' ? 'tr_TR' : 'en_GB'} />
    {altPath && <meta property="og:locale:alternate" content={lang === 'tr' ? 'en_GB' : 'tr_TR'} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    {graph && <script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />}

    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body>
    <a href="#main" class="skip-link">{lang === 'tr' ? 'Ana içeriğe geç' : 'Skip to main content'}</a>
    <Header altHref={altHref} />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <!-- The floating contact controls are position: fixed, so this wrapper
         only groups them under a landmark for screen readers. -->
    <aside aria-label={lang === 'tr' ? 'Hızlı iletişim' : 'Quick contact'}>
      <MobileActionBar />
      <ScrollToTop />
      <WhatsAppButton />
    </aside>
    <CookieBanner />

    <script>
      const revealEls = document.querySelectorAll<HTMLElement>('.reveal');
      if (revealEls.length) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.2, rootMargin: '0px 0px -40px 0px' }
        );
        revealEls.forEach((el) => observer.observe(el));
      }
    </script>
  </body>
</html>
