    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__piece:hover {
      --lift: -8px;
      --scale: 1.03;
      z-index: 9;
      box-shadow: var(--shadow-lg);
    }

    .hero__piece:hover :global(.hero__piece-img) {
      transform: scale(1.08);
    }
  }

