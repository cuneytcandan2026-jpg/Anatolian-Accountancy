---
import { Image } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Button from '../../components/Button.astro';
import StatCounter from '../../components/StatCounter.astro';
import SectionHeader from '../../components/SectionHeader.astro';
import AudienceCard from '../../components/AudienceCard.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import ProcessStep from '../../components/ProcessStep.astro';
import TestimonialCarousel from '../../components/TestimonialCarousel.astro';
import Accordion from '../../components/Accordion.astro';
import CTASection from '../../components/CTASection.astro';
import Icon from '../../components/Icon.astro';
import aatLogo from '../../assets/trust/aat-logo.webp';
import ismmmoLogo from '../../assets/trust/ismmmo-logo.png';
import capiumLogo from '../../assets/trust/capium-logo.png';
import XeroLogo from '../../assets/trust/xero-logo.svg';
import founderPhoto from '../../assets/founder-photo.jpg';
import heroDesk from '../../assets/hero-collage-desk.jpg';
import heroGherkin from '../../assets/hero-collage-gherkin.jpg';
import heroWork from '../../assets/hero-collage-work.jpg';
import heroStreet from '../../assets/hero-collage-street.jpg';
import heroCharts from '../../assets/hero-collage-charts.jpg';
import { site } from '../../lib/site';

const audiences = [
  {
    title: 'Bir işletme yürütüyorum',
    description: 'Hesaplar, KDV, bordro ve ön muhasebe sizin yerinize halledilir, siz işletmenizi yönetmeye odaklanırsınız.',
    icon: 'building',
    href: '/tr/kimlere-yardimci-oluyoruz/#limited-companies',
  },
  {
    title: 'Serbest çalışıyorum',
    description: 'Vaktini evrak işleriyle değil müşterileriyle geçirmek isteyen şahıs şirketi sahipleri için Self Assessment, giderler ve vergi planlaması.',
    icon: 'briefcase',
    href: '/tr/kimlere-yardimci-oluyoruz/#sole-traders',
  },
  {
    title: 'Bir şirket kuruyorum',
    description: 'Şirket kuruluşu, kurulum ve yeni bir işletmeyi ilk günden itibaren uyumlu tutan sürekli muhasebe desteği.',
    icon: 'rocket',
    href: '/tr/kimlere-yardimci-oluyoruz/#startups',
  },
  {
    title: 'İnşaat sektöründe çalışıyorum',
    description: 'Müteahhitlerin ve taşeronların gerçekte nasıl ödeme aldığına göre kurulmuş CIS muhasebe ve vergi desteği.',
    icon: 'hardhat',
    href: '/tr/kimlere-yardimci-oluyoruz/#construction',
  },
  {
    title: 'Online satış yapıyorum',
    description: 'Amazon, eBay, Shopify ve diğer pazar yerleri için muhasebe, çok kanallı KDV dahil.',
    icon: 'cart',
    href: '/tr/kimlere-yardimci-oluyoruz/#ecommerce',
  },
  {
    title: 'Kişisel vergi danışmanlığına ihtiyacım var',
    description: 'Self Assessment, Sermaye Kazancı Vergisi ve kira geliri, açıkça anlatılır ve zamanında beyan edilir.',
    icon: 'user',
    href: '/tr/kimlere-yardimci-oluyoruz/#personal-tax',
  },
];

const services = [
  {
    title: 'Yıllık Hesaplar ve Ön Muhasebe',
    summary: 'Yasal hesaplar, ara dönem hesapları ve günlük ön muhasebe kayıtları doğru ve güncel tutulur, böylece durumunuzu her zaman bilirsiniz.',
    icon: 'ledger',
    href: '/tr/hizmetler/#business-accounting',
  },
  {
    title: 'Kurumlar Vergisi ve Self Assessment',
    summary: 'Kurumlar vergisi, Self Assessment, ortaklık beyannameleri ve Sermaye Kazancı Vergisi karmaşık terimlerle değil, sade bir dille ele alınır ve anlatılır.',
    icon: 'tax',
    href: '/tr/hizmetler/#tax',
  },
  {
    title: 'KDV ve Bordro',
    summary: 'KDV beyannameleri doğru ve zamanında verilir; bordro ve işyeri emeklilik katkı payları ekibinizin sorunsuzca maaş almasını sağlayacak şekilde yönetilir.',
    icon: 'vat',
    href: '/tr/hizmetler/#vat-payroll',
  },
  {
    title: 'Şirket Kuruluşu ve Bulut Muhasebe',
    summary: 'Bir limited şirketi doğru şekilde kurup, modern bulut yazılımıyla yönetirsiniz, böylece defterleriniz yıl boyunca güncel kalır.',
    icon: 'formation',
    href: '/tr/hizmetler/#business-support',
  },
  {
    title: 'İnşaat Sektörü Vergi Sistemi (CIS)',
    summary: 'Müteahhitler ve taşeronlar için CIS kaydı, kesintiler ve beyannameler, inşaat muhasebeniz uyumlu kalır.',
    icon: 'hardhat',
    href: '/tr/hizmetler/#specialist',
  },
  {
    title: 'E-Ticaret Muhasebesi',
    summary: 'Amazon, eBay, Shopify ve diğer pazar yerleri için muhasebe: uygun olduğunda çok kanallı KDV ve uluslararası vergi dahil.',
    icon: 'cart',
    href: '/tr/hizmetler/#specialist',
  },
];

const whyPoints = [
  {
    icon: 'check',
    title: 'Anlaşılır tavsiye',
    desc: 'Muhasebe karmaşık terimler olmadan anlatılır: formda ne yazdığı değil, sizin için ne anlama geldiği.',
  },
  {
    icon: 'user',
    title: 'Kişisel hizmet',
    desc: 'Doğrudan Bektaş ile çalışırsınız. Hesap devirleri yok, çağrı merkezi yok, hikayenizi baştan anlatmak yok.',
  },
  {
    icon: 'arrow-up-right',
    title: 'Proaktif destek',
    desc: 'Sadece beyanname vermekle kalmayız. Sırada ne olduğunu ve planlarınız için ne anlama geldiğini size anlatırız.',
  },
  {
    icon: 'globe',
    title: 'İngilizce ve Türkçe',
    desc: 'Her görüşme, danışmanlık ve belge, en rahat olduğunuz dilde sunulur.',
  },
  {
    icon: 'ledger',
    title: 'Modern muhasebe',
    desc: 'Bulut tabanlı ön muhasebe ve raporlama sayesinde rakamlarınız üç ay geride değil, güncel kalır.',
  },
];

const testimonials = [
  {
    quote:
      "Anatolian, muhasebe ihtiyaçlarımı ayrıntılı şekilde inceledi ve benim için en uygun çözümü seçmeme yardımcı oldu; bu da Xero oldu. Anatolian'ın katkısından çok memnunum ve hizmeti tavsiye ederim.",
    name: 'Emily T.',
    context: 'İşletme sahibi',
    source: 'direct' as const,
  },
  {
    quote:
      'Olağanüstü bir muhasebe hizmeti! Dört yılı aşkın süredir Anatolian Accountancy müşterisiyim ve hizmetleri hep aynı şekilde mükemmel oldu. Ekip profesyonel, bilgili ve her zaman ulaşılabilir. Hesaplarımı titizlikle ve özenle yönetiyorlar, bu da sürecin sorunsuz ve stressiz geçmesini sağlıyor. Gösterdikleri özveri ve detaylara verdikleri önem için gerçekten minnettarım. Güvenilir ve dürüst bir muhasebeci arayan herkese şiddetle tavsiye ederim!',
    name: 'Mehmet Arslan',
    context: '4 yıldan uzun süredir müşteri',
    source: 'google' as const,
  },
  {
    quote:
      "Bir süredir Anatolian Accountancy Ltd ile çalışıyorum ve hizmetten son derece memnunum. Ekip inanılmaz derecede profesyonel, bilgili ve her türlü muhasebe ihtiyacında her zaman fazlasıyla yardımcı oluyor. Sadece titiz ve verimli değiller, aynı zamanda son derece samimi ve ulaşılabilirler; bu da tüm süreci çok daha kolay ve stressiz hale getiriyor. Güvenilir ve dürüst bir muhasebe firması arayan herkese Anatolian Accountancy Ltd'yi şiddetle tavsiye ederim! Tüm yardımlarınız için teşekkürler.",
    name: 'Yusuf',
    context: 'Yerel Rehber',
    source: 'google' as const,
  },
  {
    quote:
      'İşini titizlikle takip eden, son derece güvenilir bir muhasebeci. İhtiyacım olduğunda her zaman ulaşabilmek paha biçilemez.',
    name: 'Nalan Tanriverdi',
    source: 'google' as const,
  },
  {
    quote: '3 yıldan uzun süredir çalışıyorum. Çok memnunum. Çok yardımcı oluyorlar.',
    name: 'Gullu Sinan',
    source: 'google' as const,
  },
];

const faqItems = [
  {
    question: 'Muhasebecimi değiştirdiğimde ne olur?',
    answer:
      "Çoğu kişinin sandığından daha basit. Bizi görevlendirdiğinizde, mevcut muhasebecinizle doğrudan iletişime geçip profesyonel bir devir süreci başlatırız: kayıtlarınız, beyan geçmişiniz ve HMRC yetkilendirmeleri dahil. Geçişi kendiniz yönetmenize gerek kalmaz; bir sonraki son tarihten önce yeterli zamanla bize gelirseniz uyum sürecinde herhangi bir boşluk oluşmaz.",
  },
  {
    question: 'Serbest çalışıyorum. Gerçekte hangi vergileri ödemem gerekiyor?',
    answer:
      'Şahıs şirketi sahibi olarak, kârınız üzerinden Gelir Vergisi ve Ulusal Sigorta (National Insurance) ödersiniz; bu her yıl bir Self Assessment beyannamesiyle bildirilir. Çoğu kişinin kafasını karıştıran kısım, neyin indirilebilir gider sayılıp neyin sayılmadığını belirlemektir. Bu hesaplamayı biz yapar, son tarihten çok önce ne kadar borcunuz olduğunu size bildirir ve talep etme hakkınız olup da gözden kaçırabileceğiniz kalemleri size hatırlatırız.',
  },
  {
    question: 'Limited şirket mi kurmalıyım, yoksa şahıs şirketi olarak mı devam etmeliyim?',
    answer:
      'Bu; kâr seviyenize, işletmeden parayı nasıl çekmek istediğinize ve üstlendiğiniz riske bağlıdır. Tek bir doğru cevap yoktur. Kârlar belirli bir seviyeye ulaştığında bir limited şirket vergi açısından daha avantajlı olabilir ve size sorumluluk koruması sağlar, ancak beraberinde ek beyan yükümlülükleri getirir. Herhangi bir karar vermeden önce gerçek rakamlarınıza bakar ve artı-eksileri sizinle birlikte değerlendiririz.',
  },
  {
    question: 'KDV için ne zaman kayıt yaptırmam gerekir?',
    answer:
      'Vergiye tabi cironuz, HMRC tarafından belirlenen ve herhangi bir hareketli 12 aylık dönemde geçerli olan KDV kayıt eşiğini aştığında kayıt zorunlu hale gelir; bu eşiği aştığınız andan itibaren genellikle kayıt için 30 gününüz vardır. Bazı işletmeler bu noktadan önce, kendi lehlerine olduğu durumlarda gönüllü olarak kayıt yaptırır. Devam eden müşterilerimiz için bunu takip ederiz, böylece asla sürpriz olmaz; gönüllü kaydın sizin için mantıklı olup olmadığını da birlikte değerlendirebiliriz.',
  },
  {
    question: 'Müteahhitler ve taşeronlar için CIS nasıl işler?',
    answer:
      "İnşaat Sektörü Vergi Sistemi (CIS) kapsamında müteahhitler, taşeronun ödemesinden kesinti yapar ve bunu vergi ile Ulusal Sigorta'ya karşı bir avans olarak HMRC'ye gönderir. Bu ilişkinin her iki tarafı için de CIS kaydı, aylık beyannameler ve kesinti bildirimlerini biz yönetiriz; taşeronların hak ettikleri tutarı HMRC'de bekletmek yerine geri almalarını sağlarız.",
  },
  {
    question: 'Bir limited şirket kurmak için gerçekte ne yapmam gerekiyor?',
    answer:
      "Şirketi Companies House'a kaydettirmeniz, bir işletme banka hesabı açmanız, kurumlar vergisi için kayıt yaptırmanız ve kendinize nasıl ödeme yapacağınıza karar vermeniz gerekir. Kuruluş sürecini biz yürütür; ön muhasebe, gerekirse bordro, bulut yazılımı gibi muhasebe altyapısını ilk günden itibaren doğru şekilde kurarız, böylece bir yıl sonra karmaşayı çözmek zorunda kalmazsınız.",
  },
  {
    question: 'Yüz yüze görüşmem mi gerekiyor, yoksa her şey uzaktan mı halledilebiliyor?',
    answer:
      'Çoğu müşterimiz İngiltere\'nin neresinde olurlarsa olsunlar bizimle tamamen uzaktan çalışır: telefon, görüntülü görüşme ve bulut muhasebe yazılımı üzerinden. Yakınımızdaysanız ve yüz yüze oturmayı tercih ederseniz, Enfield ofisimiz bunun için de burada. Her iki durumda da baştan sona aynı muhasebeciyle çalışırsınız.',
  },
  {
    question: 'Türkçe muhasebe desteği alabilir miyim?',
    answer:
      'Evet, Bektaş anadili Türkçe olup ileri düzeyde İngilizce konuşmaktadır ve mali durumunuzu görüşmek için daha rahat olduğunuz dilde size destek olabilir. Bu yalnızca çevrilmiş bir broşür değil; görüşmeler, danışmanlıklar ve yazışmalar için de geçerlidir.',
  },
  {
    question: 'Ücretsiz ilk görüşme sırasında neler olur?',
    answer:
      'Bu bir satış sunumu değil, bir sohbettir. Bize işletmenizden ya da kişisel durumunuzdan, mevcut düzeninizde neyin işlemediğinden ve hangi konuda yardıma ihtiyacınız olduğundan bahsedin. Hangi hizmetlerin sizin için geçerli olduğunu, bunun kabaca neler içereceğini ve sonraki adımları dürüstçe anlatırız. Görüşme sırasında hemen kaydolma zorunluluğu yoktur.',
  },
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqItems.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer,
    },
  })),
};
---

<BaseLayout
  title="Anatolian Accountancy | Londra ve İngiltere Genelinde Türkçe Muhasebe"
  description="Londra ve İngiltere genelinde limited şirketler, şahıs şirketleri, taşeronlar ve mülk sahipleri için İngilizce veya Türkçe muhasebe, vergi ve işletme desteği. Ücretsiz görüşme ayarlayın."
  path="/tr/"
  lang="tr"
  includeLocalBusinessSchema
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--on-ink">Londra ve İngiltere Genelinde Muhasebe</p>
        <h1 class="hero__heading">İşinizi kolaylaştıran muhasebe.</h1>
        <p class="hero__lead">
          Şirketler, taşeronlar, mülk sahipleri ve bireyler için anlaşılır muhasebe, vergi ve işletme
          desteği, Londra ve İngiltere genelinde, İngilizce veya Türkçe.
        </p>
        <div class="hero__actions">
          <Button href="/tr/iletisim/" size="lg">Ücretsiz Görüşme Talep Edin</Button>
          <Button href="/tr/hizmetler/" size="lg" variant="outline-on-ink" icon="arrow-right">Hizmetlerimizi Keşfedin</Button>
        </div>

        <dl class="hero__trust">
          <div class="hero__trust-item">
            <StatCounter value={20} suffix="+" label="Yıllık muhasebe deneyimi" />
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>AAT Üyesi</dt>
            <dd>Tam üyelik</dd>
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>İngilizce &amp; Türkçe</dt>
            <dd>İki dilli hizmet</dd>
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>Londra ve İngiltere Geneli</dt>
            <dd>Enfield merkezli ofis</dd>
          </div>
        </dl>
      </div>

      <div class="hero__collage" aria-hidden="true">
        <div class="hero__piece hero__piece--blob reveal"></div>
        <div class="hero__piece hero__piece--street reveal" style="--reveal-delay:80ms">
          <Image src={heroStreet} alt="" width={500} height={800} class="hero__piece-img" />
        </div>
        <div class="hero__piece hero__piece--work reveal" style="--reveal-delay:180ms">
          <Image src={heroWork} alt="" width={560} height={760} class="hero__piece-img" />
        </div>
        <div class="hero__piece hero__piece--gherkin reveal" style="--reveal-delay:260ms">
          <Image src={heroGherkin} alt="" width={600} height={700} class="hero__piece-img" />
        </div>
        <div class="hero__piece hero__piece--charts reveal" style="--reveal-delay:340ms">
          <Image src={heroCharts} alt="" width={600} height={600} class="hero__piece-img" />
        </div>
        <div class="hero__piece hero__piece--desk reveal" style="--reveal-delay:420ms">
          <Image src={heroDesk} alt="" width={500} height={500} class="hero__piece-img" />
        </div>
        <div class="hero__piece hero__piece--blob2 reveal" style="--reveal-delay:500ms"></div>
      </div>
    </div>
  </section>

  <!-- ============ TRUST STRIP ============ -->
  <section class="trust-strip section" style="padding-block: var(--space-10) calc(var(--space-10) / 2);">
    <div class="container trust-strip__inner reveal">
      <p class="trust-strip__label">Mesleki üyelikler ve yazılımlar</p>
      <div class="trust-strip__badges">
        <div class="trust-strip__logo">
          <Image src={aatLogo} alt="AAT Lisanslı Muhasebeci" height={44} />
        </div>
        <div class="trust-strip__logo">
          <Image src={ismmmoLogo} alt="İSMMMO üyesi" height={56} />
        </div>
        <div class="trust-strip__logo trust-strip__logo--xero">
          <XeroLogo width={26} height={26} />
          <span class="trust-strip__xero-text">
            <span class="trust-strip__xero-label">Xero</span>
            <span class="trust-strip__xero-sublabel">Sertifikalı bulut yazılımı</span>
          </span>
        </div>
        <div class="trust-strip__logo">
          <Image src={capiumLogo} alt="Capium ofis yazılımı" height={30} />
        </div>
      </div>
    </div>
  </section>

  <!-- ============ HOW CAN WE HELP ============ -->
  <section class="section how-we-help">
    <div class="container">
      <SectionHeader
        eyebrow="Kimlerle çalışıyoruz"
        heading="Size nasıl yardımcı olabiliriz?"
        intro="Sizi en iyi neyin tanımladığını söyleyin, yaptığımız her şeyin genel bir listesi yerine, gerçekten geçerli olan desteğe sizi yönlendirelim."
      />
      <div class="how-we-help__grid">
        {audiences.map((item, i) => (
          <AudienceCard title={item.title} description={item.description} icon={item.icon} href={item.href} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CORE SERVICES ============ -->
  <section class="section services-section services-section--alt">
    <div class="container">
      <div class="services-section__head">
        <SectionHeader
          eyebrow="Ne yapıyoruz"
          heading="Muhasebe ve vergi, uçtan uca"
          intro="Günlük ön muhasebeden özel vergi durumlarına kadar: müşterilerimizin en çok bize güvendiği alanlar burada."
        />
        <Button href="/tr/hizmetler/" variant="ghost" class="services-section__all">Tüm hizmetleri görün</Button>
      </div>
      <div class="services-section__grid">
        {services.map((item, i) => (
          <ServiceCard title={item.title} summary={item.summary} icon={item.icon} href={item.href} index={i} linkLabel="Daha fazla bilgi" />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHY ANATOLIAN ============ -->
  <section class="section why-us">
    <div class="container">
      <SectionHeader eyebrow="Neden Anatolian" heading="Müşteriler neden kalıyor" />
      <div class="why-us__grid">
        {whyPoints.map((point, i) => (
          <div class="why-us__item reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <span class="why-us__icon"><Icon name={point.icon} /></span>
            <h3>{point.title}</h3>
            <p>{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FOUNDER ============ -->
  <section class="section founder">
    <div class="container founder__grid">
      <div class="founder__image-wrap reveal">
        <Image src={founderPhoto} alt="Bektaş Ünal, Anatolian Accountancy kurucusu ve muhasebecisi" width={367} height={661} class="founder__image" />
      </div>
      <div class="founder__copy reveal">
        <p class="eyebrow">Muhasebeciniz</p>
        <h2 class="founder__heading">Bir muhasebe şirketi değil, muhasebeciniz.</h2>
        <p class="founder__lead">
          Bektaş Ünal, Türkiye, İngiltere, İrlanda, Suudi Arabistan ve Kamerun'da inşaat, gıda &amp; içecek,
          tekstil, ormancılık ve dış kaynaklı muhasebe alanlarında yirmi yılı aşkın süre çalıştı. İstanbul
          Üniversitesi'nden Muhasebe ve Denetim alanında yüksek lisans derecesine sahip, AAT tam üyesi ve
          ACCA finalistidir.
        </p>
        <p class="founder__lead">
          2019'dan bu yana Anatolian Accountancy'yi tek bir fikir üzerine inşa etti: müşteriler, sürekli
          değişen bir vaka temsilcileri kuyruğuyla değil, işlerini gerçekten anlayan gerçek bir muhasebeciyle
          çalışmalı.
        </p>
        <div class="founder__chips">
          <span>Muhasebe ve Denetim Yüksek Lisansı</span>
          <span>AAT Tam Üyesi</span>
          <span>ACCA Finalisti</span>
          <span>Türkiye · İngiltere · İrlanda · Suudi Arabistan · Kamerun</span>
        </div>
        <Button href="/tr/hakkimizda/" variant="outline" icon="arrow-right">Bektaş'ın hikayesini okuyun</Button>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section process">
    <div class="container">
      <SectionHeader eyebrow="Başlarken" heading="Müşteri olmak basittir" tone="ink" />
      <div class="process__grid">
        <ProcessStep
          number="01"
          title="Bize kendinizden bahsedin"
