---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Button from '../components/Button.astro';
import StatCounter from '../components/StatCounter.astro';
import SectionHeader from '../components/SectionHeader.astro';
import AudienceCard from '../components/AudienceCard.astro';
import ServiceCard from '../components/ServiceCard.astro';
import ProcessStep from '../components/ProcessStep.astro';
import TestimonialCarousel from '../components/TestimonialCarousel.astro';
import Accordion from '../components/Accordion.astro';
import CTASection from '../components/CTASection.astro';
import Icon from '../components/Icon.astro';
import HeroBoxes from '../components/HeroBoxes.astro';
import VideoShowcase from '../components/VideoShowcase.astro';
import TrustStrip from '../components/TrustStrip.astro';
import founderPhoto from '../assets/founder-photo.jpg';
import heroDesk from '../assets/hero-collage-desk.jpg';
import heroPhonebox from '../assets/hero-collage-phonebox.jpg';
import heroWork from '../assets/hero-collage-work.jpg';
import heroPhonebus from '../assets/hero-collage-busbigben.jpg';
import heroCharts from '../assets/hero-collage-charts.jpg';
import { site } from '../lib/site';

const audiences = (await getCollection('audiences')).sort((a, b) => a.data.order - b.data.order);
const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const testimonials = (await getCollection('testimonials'))
  .sort((a, b) => a.data.order - b.data.order)
  .map((t) => ({ quote: t.body ?? '', name: t.data.name, context: t.data.context, source: t.data.source }));

const faqEntries = (await getCollection('faq')).sort((a, b) => a.data.order - b.data.order);
const faqGroups = [
  { key: 'getting-started', label: 'Getting Started' },
  { key: 'tax', label: 'Tax' },
  { key: 'cis', label: 'CIS' },
  { key: 'general', label: 'General' },
];
const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqEntries.map((entry) => ({
    '@type': 'Question',
    name: entry.data.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: entry.body?.trim() ?? '',
    },
  })),
};

const whyPoints = [
  {
    icon: 'check',
    title: 'Straightforward advice',
    desc: 'Accounting explained in plain English: what it means for you, not just what the form says.',
  },
  {
    icon: 'user',
    title: 'Personal service',
    desc: "You deal with Bektaş directly. No account handovers, no call centre, no starting your story over.",
  },
  {
    icon: 'arrow-up-right',
    title: 'Proactive support',
    desc: "We don't just file returns. We tell you what's coming next and what it means for your plans.",
  },
  {
    icon: 'globe',
    title: 'English & Turkish',
    desc: 'Every conversation, consultation and document is available in the language you\'re most comfortable with.',
  },
  {
    icon: 'ledger',
    title: 'Modern accounting',
    desc: 'Cloud-based bookkeeping and reporting, so your numbers are current, not three months behind.',
  },
];
---

<BaseLayout
  title="Anatolian Accountancy | Accountants in London & Enfield, English & Turkish"
  description="Accounting, tax and business support for limited companies, sole traders, contractors and landlords across London and the UK, in English or Turkish. Book a free consultation."
  path="/"
  includeLocalBusinessSchema
>
  <script type="application/ld+json" is:inline set:html={JSON.stringify(faqSchema)} />

  <!-- ============ HERO ============ -->
  <section class="hero">
    <HeroBoxes />
    <div class="hero__glow" aria-hidden="true"></div>
    <div class="container hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--on-ink">London &amp; UK-Wide Accountancy</p>
        <h1 class="hero__heading">Accountancy that makes business simpler.</h1>
        <p class="hero__lead">
          Straightforward accounting, tax and business support for companies, contractors, landlords and
          individuals across London and the UK, in English or Turkish.
        </p>
        <div class="hero__actions">
          <Button href="/contact/" size="lg">Book a Free Consultation</Button>
          <Button href="/services/" size="lg" variant="outline-on-ink" icon="arrow-right">Explore Our Services</Button>
        </div>
      </div>

      <div class="hero__visual">
        <div class="hero__collage" id="heroCollage" aria-hidden="true">
          <span class="hero__blob hero__blob--a reveal" style="--reveal-delay:0ms" data-depth="0.18"></span>
          <span class="hero__ring reveal" style="--reveal-delay:40ms" data-depth="0.22"></span>
          <span class="hero__blob hero__blob--b reveal" style="--reveal-delay:80ms" data-depth="0.15"></span>

          <div class="hero__piece hero__piece--bigben reveal" style="--reveal-delay:100ms" data-depth="0.35">
            <Image src={heroPhonebus} alt="" width={480} height={700} class="hero__piece-img" loading="eager" />
          </div>
          <div class="hero__piece hero__piece--bridge reveal" style="--reveal-delay:160ms" data-depth="0.3">
            <Image src={heroPhonebox} alt="" width={480} height={640} class="hero__piece-img" loading="eager" />
          </div>
          <div class="hero__piece hero__piece--focal reveal" style="--reveal-delay:220ms" data-depth="0.45">
            <Image src={heroWork} alt="" width={640} height={780} class="hero__piece-img" priority />
          </div>
          <div class="hero__piece hero__piece--charts reveal" style="--reveal-delay:300ms" data-depth="0.6">
            <Image src={heroCharts} alt="" width={520} height={480} class="hero__piece-img" loading="eager" />
          </div>
          <div class="hero__piece hero__piece--desk reveal" style="--reveal-delay:360ms" data-depth="0.4">
            <Image src={heroDesk} alt="" width={520} height={450} class="hero__piece-img" loading="eager" />
          </div>
        </div>

        <dl class="hero__trust">
          <div class="hero__trust-item">
            <StatCounter value={20} suffix="+" label="Years' accounting experience" />
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>AAT Member</dt>
            <dd>Full membership</dd>
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>English &amp; Turkish</dt>
            <dd>Bilingual service</dd>
          </div>
          <div class="hero__trust-item hero__trust-item--text">
            <dt>London &amp; UK-Wide</dt>
            <dd>Enfield-based office</dd>
          </div>
        </dl>
      </div>
    </div>
  </section>

  <script>
    // Hero collage — subtle scroll parallax + cursor tilt, scaled per
    // layer by data-depth. Desktop-only (matches the breakpoint where the
    // full layered composition is shown) and gated behind reduced-motion
    // and hover/fine-pointer support, so touch devices never depend on it.
    const collage = document.querySelector<HTMLElement>('#heroCollage');
    const layers = collage ? Array.from(collage.querySelectorAll<HTMLElement>('[data-depth]')) : [];
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const isDesktop = window.matchMedia('(min-width: 980px)').matches;

    if (collage && layers.length && !reduceMotion && isDesktop) {
      const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
      let ticking = false;
      let mouseX = 0;
      let mouseY = 0;

      const apply = () => {
        const rect = collage.getBoundingClientRect();
        const viewportCenter = window.innerHeight / 2;
        const scrollFactor = Math.max(-1, Math.min(1, (rect.top + rect.height / 2 - viewportCenter) / viewportCenter));

        for (const layer of layers) {
          const depth = Number(layer.dataset.depth ?? '0.3');
          const py = scrollFactor * -20 * depth + mouseY * depth;
          const px = mouseX * depth;
          layer.style.setProperty('--px', `${px.toFixed(2)}px`);
          layer.style.setProperty('--py', `${py.toFixed(2)}px`);
        }
        ticking = false;
      };

      const schedule = () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(apply);
        }
      };

      window.addEventListener('scroll', schedule, { passive: true });

      if (canHover) {
        collage.addEventListener('mousemove', (e) => {
          const rect = collage.getBoundingClientRect();
          mouseX = ((e.clientX - rect.left) / rect.width - 0.5) * 18;
          mouseY = ((e.clientY - rect.top) / rect.height - 0.5) * 18;
          schedule();
        });
        collage.addEventListener('mouseleave', () => {
          mouseX = 0;
          mouseY = 0;
          schedule();
        });
      }

      schedule();
    }
  </script>

  <!-- ============ TRUST STRIP ============ -->
  <TrustStrip />

  <!-- ============ HOW CAN WE HELP ============ -->
  <section class="section how-we-help">
    <div class="container">
      <div class="how-we-help__head">
        <SectionHeader
          eyebrow="Who we work with"
          heading="How can we help?"
          intro="Tell us what best describes you, and we'll point you to the support that actually applies, not a generic list of everything we do."
        />
        <VideoShowcase
          class="how-we-help__video"
          src="/videos/calculator.mp4"
          poster="/videos/calculator-poster.jpg"
        />
      </div>
      <div class="how-we-help__grid">
        {audiences.map((item, i) => (
          <AudienceCard
            title={item.data.title}
            description={item.data.description}
            icon={item.data.icon}
            href={item.data.href}
            index={i}
          />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ CORE SERVICES ============ -->
  <section class="section services-section services-section--alt">
    <div class="container">
      <div class="services-section__head">
        <SectionHeader
          eyebrow="What we do"
          heading="Accounting and tax, covered end to end"
          intro="From day-to-day bookkeeping to specialist tax positions: here are the areas clients lean on us for most."
        />
        <Button href="/services/" variant="ghost" class="services-section__all">View all services</Button>
      </div>
      <div class="services-section__grid">
        {services.map((item, i) => (
          <ServiceCard title={item.data.title} summary={item.data.summary} icon={item.data.icon} href={item.data.href} index={i} />
        ))}
      </div>
    </div>
  </section>

  <!-- ============ WHY ANATOLIAN ============ -->
  <section class="section why-us">
    <div class="container">
      <SectionHeader eyebrow="Why Anatolian" heading="Why clients stay" />
      <div class="why-us__grid">
        {whyPoints.map((point, i) => (
          <div class="why-us__item reveal" style={`--reveal-delay:${(i % 3) * 90}ms`}>
            <span class="why-us__icon"><Icon name={point.icon} /></span>
            <h3>{point.title}</h3>
            <p>{point.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FOUNDER ============ -->
  <section class="section founder">
    <div class="container founder__grid">
      <div class="founder__image-wrap reveal">
        <Image src={founderPhoto} alt="Bektaş Ünal, founder and accountant at Anatolian Accountancy" width={367} height={661} class="founder__image" />
      </div>
      <div class="founder__copy reveal">
        <p class="eyebrow">Meet your accountant</p>
        <h2 class="founder__heading">Your accountant, not just an accounting company.</h2>
        <p class="founder__lead">
          Bektaş Ünal has spent more than twenty years in accounting, across construction, food &amp;
          beverage, textiles, forestry and outsourced accounting, in Turkey, the UK, Ireland, Saudi Arabia
          and Cameroon. He holds an MSc in Accounting &amp; Auditing from Istanbul University, is a full
          member of the AAT and an ACCA finalist.
        </p>
        <p class="founder__lead">
          Since 2019 he's built Anatolian Accountancy around one idea: clients should deal with a real
          accountant who understands their business, not a rotating queue of case handlers.
        </p>
        <div class="founder__chips">
          <span>MSc Accounting &amp; Auditing</span>
          <span>AAT Full Member</span>
          <span>ACCA Finalist</span>
          <span>Turkey · UK · Ireland · Saudi Arabia · Cameroon</span>
        </div>
        <Button href="/about/" variant="outline" icon="arrow-right">Read Bektaş's story</Button>
      </div>
    </div>
  </section>

  <!-- ============ PROCESS ============ -->
  <section class="section process">
    <div class="container">
      <SectionHeader
        eyebrow="Getting started"
        heading="Becoming a client is simple"
        tone="ink"
      />
      <div class="process__grid">
        <ProcessStep
          number="01"
          title="Tell us about yourself"
          description="Book a free consultation and tell us what kind of support you need. No forms to fill in first."
          index={0}
        />
        <ProcessStep
          number="02"
          title="We review your requirements"
          description="We look at your situation and recommend the accounting and tax services that actually apply to you."
          index={1}
        />
        <ProcessStep
          number="03"
          title="We take care of the numbers"
          description="You get on with running your business. We manage the ongoing accounting and keep you ahead of deadlines."
          index={2}
        />
      </div>
      <div class="process__cta reveal">
        <Button href="/contact/" size="lg" variant="outline-on-ink">Book a Free Consultation</Button>
      </div>
    </div>
  </section>

  <!-- ============ TESTIMONIALS ============ -->
  <section class="section testimonials">
    <div class="container">
      <SectionHeader eyebrow="What clients say" heading="Trusted by business owners and individuals across London" tone="ink" align="center" />
      <TestimonialCarousel
        testimonials={testimonials}
        rating={site.googleRating}
        reviewCount={site.googleReviewCount}
        reviewsUrl={site.googleReviewsUrl}
        lang="en"
      />
    </div>
  </section>

  <!-- ============ BILINGUAL CALLOUT ============ -->
  <section class="section bilingual">
    <div class="container">
      <div class="bilingual__panel reveal">
        <div class="bilingual__text">
          <p class="eyebrow">Bilingual service</p>
          <h2>Prefer to discuss your finances in Turkish?</h2>
          <p class="bilingual__desc">
            Bektaş speaks native Turkish and advanced English, so you can go through your accounts, tax
            position or business plans in whichever language you're more comfortable with.
          </p>
          <p class="bilingual__tr">Muhasebe ve vergi konularında Türkçe destek almak için tıklayın.</p>
        </div>
        <Button href="/tr/" size="lg" icon="arrow-right">Türkçe bilgi alın</Button>
      </div>
    </div>
  </section>

  <!-- ============ FAQ ============ -->
  <section class="section faq">
    <div class="container faq__grid">
      <SectionHeader eyebrow="Common questions" heading="Answers before you ask" class="faq__header" />
      <div class="faq__groups">
        {faqGroups.map((g) => (
          <div class="faq__group">
            <p class="eyebrow faq__group-label">{g.label}</p>
            <Accordion group={g.key} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ============ FINAL CTA ============ -->
  <CTASection
    eyebrow="Ready when you are"
    heading="Let's make your accounting simpler."
    intro="Book an initial consultation and tell us what support you need. There's no cost and no obligation to sign up."
  />
</BaseLayout>

<style>
  /* ---- Hero ---- */
  .hero {
    position: relative;
    background: var(--bg-ink);
    color: var(--text-on-ink);
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(4rem, 3rem + 4vw, 7rem);
  }

  .hero__glow {
    position: absolute;
    inset: -30% -10% auto auto;
    width: 46rem;
    height: 46rem;
    z-index: 1;
    background: radial-gradient(circle, var(--c-azure-glow), transparent 65%);
    pointer-events: none;
  }

  .hero__grid {
    position: relative;
    z-index: 2;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: var(--space-12);
    align-items: start;
  }

  /* Stacks the photo collage and trust stats together so the stats sit
     snugly under the photos regardless of how tall the copy column is —
     order:-1 on .hero__trust puts stats before photos on mobile (closer
     to the CTA buttons); desktop flips it back to photos-then-stats to
     fill the empty space below the collage. */
  .hero__visual {
    display: flex;
    flex-direction: column;
  }

  .hero__heading {
    margin-top: var(--space-5);
    font-size: var(--fs-hero);
    letter-spacing: var(--ls-tighter);
    color: var(--text-on-ink);
    max-width: 16ch;
  }

  .hero__lead {
    margin-top: var(--space-6);
    font-size: var(--fs-lead);
    line-height: var(--lh-relaxed);
    color: var(--text-on-ink-muted);
    max-width: 38rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }

  .hero__trust {
    order: -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-6);
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border-on-ink);
  }

  .hero__trust-item--text dt {
    font-weight: 700;
    font-size: var(--fs-small);
    color: var(--text-on-ink);
  }

  .hero__trust-item--text dd {
    margin: 0.2rem 0 0;
    font-size: 0.8125rem;
    color: var(--text-on-ink-muted);
  }

  /* ---- Hero photo collage ----
     Editorial layered composition: one focal image (accountancy/service)
     supported by London-landmark and business-imagery cards at varying
     depths, plus floating label chips. Mobile shows a simplified 2-card
     version and progressively reveals more layers at wider breakpoints
     rather than just shrinking the full desktop composition (see the
     min-width:600px/980px tiers below). Depth is driven two ways: static
     rotation + shadow/z-index per card (art direction), and a shared
     translate3d(--px,--py) formula that the hero-parallax script (right
     after this section's markup) drives per data-depth on scroll/cursor.
  */
  .hero__collage {
    grid-area: collage;
    position: relative;
    width: 100%;
    max-width: 26rem;
    aspect-ratio: 0.95;
    margin-inline: auto;
  }

  /* Shared depth formula for every layer (photos, blobs, ring, chips) —
     one rule so the scroll/cursor parallax script (data-depth) and the
     hover lift/scale both compose into a single transform. Kept separate
     from the site-wide .reveal/.reveal.is-visible rules further down,
     which win the cascade on `transform` (two classes vs. one) and would
     otherwise silently clobber this; the #heroCollage-scoped overrides
     right after the collage markup re-fold the reveal slide-in into this
     same formula via --reveal-y instead of fighting for specificity. */
  #heroCollage [data-depth] {
    transform: translate3d(var(--px, 0px), calc(var(--py, 0px) + var(--lift, 0px) + var(--reveal-y, 0px)), 0)
      rotate(var(--rot, 0deg)) scale(var(--scale, 1));
    transition: transform var(--duration-base) var(--ease-out), box-shadow var(--duration-base) var(--ease-out);
  }

  html.js #heroCollage .reveal {
    --reveal-y: 24px;
  }

  html.js #heroCollage .reveal.is-visible {
    --reveal-y: 0px;
  }

  .hero__piece {
    position: absolute;
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .hero__piece :global(.hero__piece-img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform var(--duration-slow) var(--ease-out);
  }

  @media (hover: hover) and (pointer: fine) {
    .hero__piece:hover {
      --lift: -8px;
      --scale: 1.03;
      z-index: 9;
      box-shadow: var(--shadow-lg);
    }

    .hero__piece:hover :global(.hero__piece-img) {
      transform: scale(1.08);
    }
  }

  /* Focal card — the accountancy/service moment the story leads with */
  .hero__piece--focal {
    left: 19%;
    top: 7%;
    width: 61%;
    height: 67%;
    z-index: 4;
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
  }

  /* London — establishes place */
  .hero__piece--bigben {
    left: -2%;
    top: 0;
    width: 38%;
    height: 48%;
    z-index: 3;
    border-radius: var(--radius-lg);
    --rot: -4deg;
  }

  .hero__piece--bridge {
    right: -2%;
    top: 2%;
    width: 38%;
    height: 48%;
    z-index: 2;
    border-radius: var(--radius-lg);
    --rot: 3deg;
    display: none;
  }

  /* Business + accounts — the work itself */
  .hero__piece--charts {
    left: -7%;
    bottom: -1%;
    width: 38%;
    height: 48%;
    z-index: 5;
    border-radius: var(--radius-lg);
    border: 4px solid var(--bg-ink);
    --rot: -3deg;
    display: none;
  }

  .hero__piece--desk {
    right: -4%;
    bottom: -3%;
    width: 38%;
    height: 48%;
    z-index: 3;
    border-radius: var(--radius-lg);
    --rot: 2deg;
    display: none;
  }

  /* Decorative brand shapes, peeking from behind the photography */
  .hero__blob,
  .hero__ring {
    position: absolute;
    z-index: 1;
    aspect-ratio: 1;
    pointer-events: none;
  }

  .hero__blob--a {
    top: -7%;
    right: 6%;
    width: 19%;
    background: var(--c-ink-600);
    border-radius: 62% 38% 55% 45% / 48% 55% 45% 52%;
  }

  .hero__blob--b {
    bottom: 6%;
    left: 2%;
    width: 15%;
    background: var(--cta);
    border-radius: 45% 55% 60% 40% / 55% 45% 55% 45%;
    display: none;
  }

  .hero__ring {
    top: 40%;
    left: -8%;
    width: 12%;
    border: 2px solid var(--border-on-ink);
    border-radius: 50%;
    display: none;
  }

  @media (min-width: 600px) {
    .hero__collage {
      max-width: 29rem;
    }

    .hero__piece--desk {
      display: block;
    }
  }

  @media (min-width: 980px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
      gap: var(--space-12);
    }

    .hero__collage {
      max-width: 33rem;
      margin-top: var(--space-8);
      margin-left: auto;
      margin-right: 0;
    }

    .hero__blob--b,
    .hero__ring,
    .hero__piece--bridge,
    .hero__piece--charts {
      display: block;
    }

    .hero__trust {
      order: 0;
      margin-bottom: 0;
      padding-bottom: 0;
      border-bottom: none;
      margin-top: var(--space-8);
      padding-top: var(--space-6);
      border-top: 1px solid var(--border-on-ink);
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ---- How we help ---- */
  .how-we-help__head {
    display: grid;
    gap: var(--space-8);
    align-items: center;
  }

  :global(.how-we-help__video) {
    max-width: 26rem;
    width: 100%;
    justify-self: start;
  }

  @media (min-width: 960px) {
    .how-we-help__head {
      grid-template-columns: minmax(0, 1fr) minmax(20rem, 26rem);
    }

    :global(.how-we-help__video) {
      justify-self: end;
    }
  }

  .how-we-help__grid {
    margin-top: var(--space-10);
    display: grid;
    gap: var(--space-5);
    grid-template-columns: repeat(auto-fill, minmax(15.5rem, 1fr));
  }

  /* ---- Services ---- */
  .services-section--alt {
    background: var(--bg-muted);
  }

  .services-section__head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: var(--space-6);
  }

  :global(.services-section__all) {
    flex-shrink: 0;
  }

  .services-section__grid {
