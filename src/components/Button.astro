---
import Icon from './Icon.astro';
import { withBase } from '../lib/site';

interface Props {
  href: string;
  variant?: 'primary' | 'primary-on-ink' | 'dark' | 'outline' | 'ghost';
  size?: 'md' | 'lg';
  icon?: string;
  class?: string;
}

const { href, variant = 'primary', size = 'md', icon = 'arrow-right', class: className = '' } = Astro.props;
const isExternal = href.startsWith('http') || href.startsWith('tel:') || href.startsWith('mailto:');
const resolvedHref = isExternal || href.startsWith('#') ? href : withBase(href);
---

<a
  href={resolvedHref}
  class={`btn btn--${variant} btn--${size} ${className}`}
  target={isExternal && href.startsWith('http') ? '_blank' : undefined}
  rel={isExternal && href.startsWith('http') ? 'noopener noreferrer' : undefined}
>
  <span><slot /></span>
  {icon && <Icon name={icon} class="btn__icon" />}
</a>

<style>
  .btn {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.6em;
    font-family: var(--font-body);
    font-weight: 600;
    text-decoration: none;
    white-space: nowrap;
    border-radius: var(--radius-full);
    border: 1px solid transparent;
    transition: transform var(--duration-fast) var(--ease-out), box-shadow var(--duration-fast) var(--ease-out),
      background-color var(--duration-fast) var(--ease-out), border-color var(--duration-fast) var(--ease-out),
      color var(--duration-fast) var(--ease-out);
  }

  .btn:hover {
    transform: translateY(-1px) scale(1.015);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn :global(.btn__icon) {
    width: 1.05em;
    height: 1.05em;
    transition: transform var(--duration-fast) var(--ease-out);
  }

  .btn:hover :global(.btn__icon) {
    transform: translateX(3px);
  }

  .btn--md {
    padding: 0.85rem 1.5rem;
    font-size: var(--fs-small);
  }

  .btn--lg {
    padding: 1.05rem 1.9rem;
    font-size: 1.0625rem;
  }

  .btn--primary {
    background: var(--cta);
    color: var(--cta-text);
    box-shadow: var(--shadow-cta);
  }

  .btn--primary:hover {
    background: var(--cta-hover);
    box-shadow: 0 20px 40px -14px var(--c-azure-glow-strong);
  }

  /* Every button on the azure sections — an Azure or see-through button
     washes out there (client feedback), so they're all solid white with
     deep-azure text, secondary actions included. */
  .btn--primary-on-ink {
    background: var(--cta-on-ink);
    color: var(--cta-on-ink-text);
    box-shadow: var(--shadow-cta-on-ink);
  }

  .btn--primary-on-ink:hover {
    background: var(--cta-on-ink-hover);
    box-shadow: 0 20px 40px -14px rgba(0, 26, 51, 0.55);
  }

  .btn--dark {
    background: var(--bg-ink);
    color: var(--text-on-ink);
  }

  .btn--dark:hover {
    background: var(--c-azure-700);
  }

  .btn--outline {
    background: transparent;
    color: var(--text-primary);
    border-color: var(--border-strong);
  }

  .btn--outline:hover {
    border-color: var(--text-primary);
    background: rgba(0, 127, 255, 0.06);
  }

  .btn--ghost {
    background: transparent;
    color: var(--text-primary);
    padding-inline: 0.15rem;
  }

  .btn--ghost :global(.btn__icon) {
    color: var(--accent);
  }

  .btn--ghost:hover {
    transform: none;
    color: var(--text-accent);
  }
</style>
