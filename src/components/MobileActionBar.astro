---
import Icon from './Icon.astro';
import { site, withBase, stripBase } from '../lib/site';

const isTurkish = stripBase(Astro.url.pathname).startsWith('/tr/');
const contactHref = isTurkish ? '/tr/iletisim/' : '/contact/';
---

<div class="action-bar" id="mobile-action-bar">
  <a href={site.phoneHref} class="action-bar__link action-bar__link--call">
    <Icon name="phone" />
    <span>{isTurkish ? 'Ara' : 'Call'}</span>
  </a>
  <a href={withBase(contactHref)} class="action-bar__link action-bar__link--book">
    <Icon name="arrow-right" />
    <span>{isTurkish ? 'Ücretsiz Görüşme Talep Edin' : 'Book a Free Consultation'}</span>
  </a>
</div>

<script>
  const bar = document.getElementById('mobile-action-bar');
  const footer = document.querySelector('footer.footer');

  if (bar) {
    const onScroll = () => {
      bar.classList.toggle('is-visible', window.scrollY > 420);
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });

    if (footer && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            bar.classList.toggle('is-near-footer', entry.isIntersecting);
          }
        },
        { rootMargin: '0px' }
      );
      observer.observe(footer);
    }
  }
</script>

<style>
  .action-bar {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 90;
    display: flex;
    gap: 1px;
    background: var(--border-on-ink);
    padding-bottom: env(safe-area-inset-bottom);
    transform: translateY(100%);
    opacity: 0;
    transition: transform var(--duration-base) var(--ease-out), opacity var(--duration-base) var(--ease-out);
    box-shadow: 0 -8px 24px -8px rgba(20, 72, 103, 0.22);
  }

  .action-bar.is-visible {
    transform: translateY(0);
    opacity: 1;
  }

  .action-bar.is-near-footer {
    transform: translateY(100%);
    opacity: 0;
  }

  .action-bar__link {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-height: 56px; /* keep in sync with --mobile-action-bar-h in tokens.css */
    font-size: var(--fs-small);
    font-weight: 700;
    text-decoration: none;
  }

  .action-bar__link :global(svg) {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
  }

  .action-bar__link--call {
    flex: 0 0 30%;
    background: var(--bg-ink);
    color: var(--text-on-ink);
  }

  .action-bar__link--book {
    background: var(--cta);
    color: var(--c-ink-950);
  }

  @media (min-width: 900px) {
    .action-bar {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .action-bar {
      transition: none;
    }
  }
</style>
