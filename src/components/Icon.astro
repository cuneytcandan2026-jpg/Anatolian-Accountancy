---
interface Props {
  name: string;
  class?: string;
}

const { name, class: className = '' } = Astro.props;
---

<svg
  class={`icon ${className}`}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.6"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
>
  {name === 'menu' && <><line x1="3" y1="6.5" x2="21" y2="6.5" /><line x1="3" y1="12" x2="21" y2="12" /><line x1="3" y1="17.5" x2="21" y2="17.5" /></>}
  {name === 'close' && <><line x1="5" y1="5" x2="19" y2="19" /><line x1="19" y1="5" x2="5" y2="19" /></>}
  {name === 'chevron-down' && <polyline points="6 9 12 15 18 9" />}
  {name === 'chevron-left' && <polyline points="15 6 9 12 15 18" />}
  {name === 'chevron-right' && <polyline points="9 6 15 12 9 18" />}
  {name === 'star' && <path d="M12 2 15.09 8.26 22 9.27 17 14.14 18.18 21.02 12 17.77 5.82 21.02 7 14.14 2 9.27 8.91 8.26 12 2Z" fill="currentColor" stroke="none" />}
  {name === 'arrow-right' && <><line x1="4" y1="12" x2="20" y2="12" /><polyline points="13 5 20 12 13 19" /></>}
  {name === 'arrow-up-right' && <><line x1="6" y1="18" x2="18" y2="6" /><polyline points="8 6 18 6 18 16" /></>}
  {name === 'phone' && <path d="M6.6 3.5 9.3 8 6.9 10.4a13 13 0 0 0 6.7 6.7l2.4-2.4 4.5 2.7v3.4a2 2 0 0 1-2.2 2C10.7 20 4 13.3 3.2 5.7a2 2 0 0 1 2-2.2h1.4Z" />}
  {name === 'mail' && <><rect x="3" y="5.5" width="18" height="13" rx="2" /><polyline points="3.5 6.5 12 13 20.5 6.5" /></>}
  {name === 'map-pin' && <><path d="M12 21s7-6.4 7-11.6A7 7 0 0 0 5 9.4C5 14.6 12 21 12 21Z" /><circle cx="12" cy="9.4" r="2.4" /></>}
  {name === 'clock' && <><circle cx="12" cy="12" r="8.5" /><polyline points="12 7.5 12 12 15.5 14" /></>}
  {name === 'check' && <polyline points="5 12.5 9.5 17 19 6" />}
  {name === 'globe' && <><circle cx="12" cy="12" r="8.5" /><path d="M3.5 12h17" /><path d="M12 3.5c2.4 2.4 3.6 5.4 3.6 8.5s-1.2 6.1-3.6 8.5c-2.4-2.4-3.6-5.4-3.6-8.5S9.6 5.9 12 3.5Z" /></>}
  {name === 'ledger' && <><rect x="4.5" y="3.5" width="15" height="17" rx="1.6" /><line x1="8" y1="8" x2="16" y2="8" /><line x1="8" y1="12" x2="16" y2="12" /><line x1="8" y1="16" x2="13" y2="16" /></>}
  {name === 'tax' && <><path d="M4 6.5 12 3l8 3.5v4c0 5.2-3.4 9.3-8 10.5-4.6-1.2-8-5.3-8-10.5v-4Z" /><polyline points="9 12 11.2 14.2 15.5 9.8" /></>}
  {name === 'vat' && <><circle cx="8.5" cy="8.5" r="3" /><circle cx="15.5" cy="15.5" r="3" /><line x1="6" y1="18" x2="18" y2="6" /></>}
  {name === 'formation' && <><path d="M4 20V10.5L12 4l8 6.5V20" /><rect x="9.5" y="13.5" width="5" height="6.5" /></>}
  {name === 'hardhat' && <><path d="M4 15.5a8 8 0 0 1 16 0" /><rect x="3" y="15.5" width="18" height="3" rx="1.2" /><line x1="12" y1="4" x2="12" y2="8" /></>}
  {name === 'cart' && <><circle cx="10" cy="20" r="1.4" /><circle cx="17.5" cy="20" r="1.4" /><path d="M3.5 4h2.3L8.4 15h9.7l2.4-8.5H6.4" /></>}
  {name === 'building' && <><rect x="5" y="3.5" width="14" height="17" rx="1.2" /><line x1="8.5" y1="7.5" x2="8.5" y2="7.5" /><line x1="12" y1="7.5" x2="12" y2="7.5" /><line x1="15.5" y1="7.5" x2="15.5" y2="7.5" /><line x1="8.5" y1="11" x2="8.5" y2="11" /><line x1="12" y1="11" x2="12" y2="11" /><line x1="15.5" y1="11" x2="15.5" y2="11" /><line x1="8.5" y1="14.5" x2="8.5" y2="14.5" /><line x1="12" y1="14.5" x2="12" y2="14.5" /><line x1="15.5" y1="14.5" x2="15.5" y2="14.5" /><path d="M9.5 20.5V17.5h5v3" /></>}
  {name === 'briefcase' && <><rect x="3.5" y="8" width="17" height="11.5" rx="1.8" /><path d="M8.5 8V6a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v2" /><line x1="3.5" y1="13.2" x2="20.5" y2="13.2" /></>}
  {name === 'rocket' && <><path d="M12 3.5c3 1.5 5 4.7 5 8.4 0 2-1 4.3-2 5.6l-1.8-1a5.7 5.7 0 0 0-2.4 0l-1.8 1c-1-1.3-2-3.6-2-5.6 0-3.7 2-6.9 5-8.4Z" /><circle cx="12" cy="10.5" r="1.6" /><path d="M9 17.5 7 21M15 17.5l2 3.5" /></>}
  {name === 'user' && <><circle cx="12" cy="8.5" r="3.5" /><path d="M4.5 20a7.5 7.5 0 0 1 15 0" /></>}
  {name === 'facebook' && <path d="M14.5 21v-7.2h2.4l.4-2.8h-2.8V9.2c0-.8.2-1.4 1.4-1.4h1.5V5.3c-.3 0-1.2-.1-2.2-.1-2.2 0-3.7 1.3-3.7 3.8V11H9v2.8h2.5V21h3Z" />}
  {name === 'instagram' && <><rect x="3.5" y="3.5" width="17" height="17" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="1" /></>}
  {name === 'linkedin' && <><rect x="3.5" y="3.5" width="17" height="17" rx="2.5" /><line x1="7.5" y1="10" x2="7.5" y2="17" /><circle cx="7.5" cy="7" r="0.2" /><path d="M11.5 17v-4.2c0-1.6 1-2.5 2.3-2.5s2.2.9 2.2 2.5V17" /><line x1="11.5" y1="10" x2="11.5" y2="17" /></>}
  {name === 'quote' && <path d="M9.5 6.5c-3 1.3-4.5 3.6-4.5 6.6a4 4 0 0 0 4 4.1 3.4 3.4 0 0 0 3.4-3.5c0-1.8-1.2-3-2.9-3.2.3-1.7 1.5-3 3.3-3.7l-3.3-.3Zm8.5 0c-3 1.3-4.5 3.6-4.5 6.6a4 4 0 0 0 4 4.1 3.4 3.4 0 0 0 3.4-3.5c0-1.8-1.2-3-2.9-3.2.3-1.7 1.5-3 3.3-3.7L18 6.5Z" fill="currentColor" stroke="none" />}
</svg>
