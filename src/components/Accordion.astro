---
import { getCollection, render } from 'astro:content';
import Icon from './Icon.astro';

interface Props {
  items?: { question: string; answer: string }[];
  group?: string;
}

const { items, group } = Astro.props;

type Row = { id: string; question: string; Content?: any; answer?: string };

let rows: Row[];

if (items) {
  rows = items.map((item, i) => ({ id: `faq-tr-${i}`, question: item.question, answer: item.answer }));
} else {
  const faqEntries = (await getCollection('faq', (e) => !group || e.data.group === group)).sort(
    (a, b) => a.data.order - b.data.order
  );
  const rendered = await Promise.all(faqEntries.map((entry) => render(entry)));
  rows = faqEntries.map((entry, i) => ({ id: entry.id, question: entry.data.question, Content: rendered[i].Content }));
}
---

<div class="accordion reveal">
  {rows.map((row, i) => {
    const { Content } = row;
    return (
      <div class="accordion__item">
        <h3>
          <button
            type="button"
            class="accordion__trigger"
            aria-expanded={i === 0 ? 'true' : 'false'}
            aria-controls={`faq-panel-${row.id}`}
            id={`faq-trigger-${row.id}`}
          >
            <span>{row.question}</span>
            <Icon name="chevron-down" class="accordion__chevron" />
          </button>
        </h3>
        <div
          class={`accordion__panel ${i === 0 ? 'is-open' : ''}`}
          id={`faq-panel-${row.id}`}
          role="region"
          aria-labelledby={`faq-trigger-${row.id}`}
          aria-hidden={i === 0 ? 'false' : 'true'}
        >
          <div class="accordion__panel-inner">
            {Content ? <Content /> : <p>{row.answer}</p>}
          </div>
        </div>
      </div>
    );
  })}
</div>

<script>
  const items = document.querySelectorAll<HTMLElement>('.accordion__item');

  items.forEach((item) => {
    const trigger = item.querySelector<HTMLButtonElement>('.accordion__trigger');
    const panel = item.querySelector<HTMLElement>('.accordion__panel');
    trigger?.addEventListener('click', () => {
      const isOpen = trigger.getAttribute('aria-expanded') === 'true';
      trigger.setAttribute('aria-expanded', String(!isOpen));
      if (panel) {
        panel.classList.toggle('is-open', !isOpen);
        panel.setAttribute('aria-hidden', String(isOpen));
      }
    });
  });
</script>

<style>
  .accordion {
    display: flex;
    flex-direction: column;
  }

  .accordion__item {
    border-bottom: 1px solid var(--border-subtle);
  }

  .accordion__item h3 {
    margin: 0;
    font-family: var(--font-body);
  }

  .accordion__trigger {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-block: 1.5rem;
    background: none;
    border: none;
    text-align: left;
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
    cursor: pointer;
  }

  .accordion__trigger :global(.accordion__chevron) {
    flex-shrink: 0;
    width: 20px;
    height: 20px;
    color: var(--text-accent);
    transition: transform var(--duration-base) var(--ease-out);
  }

  .accordion__trigger[aria-expanded='true'] :global(.accordion__chevron) {
    transform: rotate(180deg);
  }

  .accordion__panel {
    display: grid;
    grid-template-rows: 0fr;
    overflow: hidden;
    transition: grid-template-rows var(--duration-base) var(--ease-out);
  }

  .accordion__panel.is-open {
    grid-template-rows: 1fr;
  }

  .accordion__panel-inner {
    min-height: 0;
    overflow: hidden;
    max-width: 42rem;
    padding-bottom: 1.5rem;
    color: var(--text-secondary);
    line-height: var(--lh-relaxed);
  }

  .accordion__panel-inner :global(p) {
    margin: 0;
  }
</style>
