---
import Button from './Button.astro';

interface Props {
  eyebrow: string;
  heading: string;
  intro: string;
}

const { eyebrow, heading, intro } = Astro.props;
---

<section class="stub">
  <div class="stub__glow" aria-hidden="true"></div>
  <div class="container stub__inner">
    <p class="eyebrow eyebrow--on-ink">{eyebrow}</p>
    <h1 class="stub__heading">{heading}</h1>
    <p class="stub__intro">{intro}</p>
    <p class="stub__note">This page is being finished as part of our site rebuild. In the meantime, get in touch directly and we'll help with exactly what you need.</p>
    <div class="stub__actions">
      <Button href="/contact/" size="lg">Book a Free Consultation</Button>
      <Button href="/" size="lg" variant="outline-on-ink">Back to Home</Button>
    </div>
  </div>
</section>

<style>
  .stub {
    position: relative;
    background: var(--bg-ink);
    color: var(--text-on-ink);
    overflow: hidden;
    padding-block: clamp(3rem, 2rem + 4vw, 6rem) clamp(4rem, 3rem + 4vw, 7rem);
  }

  .stub__glow {
    position: absolute;
    inset: -20% auto auto -10%;
    width: 36rem;
    height: 36rem;
    background: radial-gradient(circle, var(--c-azure-glow), transparent 65%);
    pointer-events: none;
  }

  .stub__inner {
    position: relative;
    max-width: 42rem;
  }

  .stub__heading {
    margin-top: var(--space-4);
    font-size: var(--fs-h1);
  }

  .stub__intro {
    margin-top: var(--space-5);
    font-size: var(--fs-lead);
    color: var(--text-on-ink-muted);
  }

  .stub__note {
    margin-top: var(--space-4);
    font-size: var(--fs-small);
    color: var(--text-on-ink-muted);
    opacity: 0.8;
  }

  .stub__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    margin-top: var(--space-8);
  }
</style>
